# =========================================================
# AntiGravity ColdChain - Configuração de Ambiente (.env)
# =========================================================

# 1. Credenciais Tuya Cloud OpenAPI
# Obtenha em https://platform.tuya.com (Cloud > Development > Seu Projeto)
TUYA_ENDPOINT=https://openapi.tuyaus.com
TUYA_ACCESS_ID=seu_access_id
TUYA_ACCESS_SECRET=seu_access_secret

# 2. Configurações Padrão de Limites Térmicos (°C)
FREEZER_CONGELADOS_MIN=-22.0
FREEZER_CONGELADOS_MAX=-15.0

# 3. Notificações Telegram Bot
# Crie o bot com o @BotFather no Telegram para obter o Token
TELEGRAM_BOT_TOKEN=seu_bot_token
# Seu ID de usuário ou grupo (obtenha com @userinfobot)
TELEGRAM_CHAT_ID=seu_chat_id

# 4. Banco de Dados (Opcional - por padrão usa SQLite automático)
# SQLite: sqlite+aiosqlite:///coldchain.db
# PostgreSQL: postgresql://usuario:senha@localhost:5432/coldchain
DATABASE_URL=sqlite+aiosqlite:///coldchain.db

# 5. Envio de E-mail de Verificação (Gmail / Google Workspace / Outlook)
# Para Gmail: use a "Senha de App" de 16 letras gerada na sua Conta Google (Segurança > Verificação em 2 etapas > Senhas de app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=ControlCold <seu_email@gmail.com>
